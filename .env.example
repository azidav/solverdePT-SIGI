# ------------------------------------------------------------------------------
# .env.production.example
#
# Copia este ficheiro para .env no servidor e preenche os valores:
#   cp .env.production.example .env
#   nano .env
#
# NUNCA cometas o .env ao git (já está no .gitignore).
# ------------------------------------------------------------------------------

# === OBRIGATÓRIO ==============================================================

# --- Base de dados ---
POSTGRES_USER=sigi
POSTGRES_PASSWORD=TROCA-por-uma-password-forte
POSTGRES_DB=sigi_prod

# --- Segredo dos JSON Web Tokens (sessões) ---
# Gera um novo com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   (ou, sem Node:  openssl rand -hex 64)
JWT_SECRET=cola-aqui-um-segredo-aleatorio-longo

# === OPCIONAL (têm valores por defeito) =======================================

# Porta em que a app fica exposta no servidor. Default: 3000.
# Com Nginx à frente, mantém 3000 e faz o proxy 443 -> 3000.
APP_PORT=3000

# Duração da sessão em segundos. Default: 28800 (8 horas).
# JWT_EXPIRES_IN=28800

# URL pública (usada apenas como fallback em alguns links de email).
# Os links de ativação/recuperação usam normalmente o host do pedido,
# por isso este valor raramente é necessário.
NUXT_PUBLIC_BASE_URL=https://sigi.solverde.pt

# ------------------------------------------------------------------------------
# NOTA: a configuração de EMAIL/SMTP não é feita aqui. É feita dentro da
# aplicação, em Definições -> Email (guardada na tabela config_variables).
# ------------------------------------------------------------------------------
